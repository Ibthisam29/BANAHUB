{
  "version": 2,
  "name": "banahub",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "banahub-complete-final/Banahub platform",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/apply",
      "destination": "/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/programs",
      "destination": "/programs.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/insights",
      "destination": "/insights.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/join",
      "destination": "/membership.html"
    },
    {
      "source": "/program-register",
      "destination": "/program-register.html"
    },
    {
      "source": "/apply-program",
      "destination": "/program-register.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/disclosures",
      "destination": "/disclosures.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/event.html?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "banahub.com"
        }
      ],
      "destination": "https://www.banahub.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/events/capital-growth-exchange",
      "destination": "/capital-growth-exchange",
      "permanent": false
    },
    {
      "source": "/services",
      "destination": "/market-entry",
      "permanent": false
    },
    {
      "source": "/service-gtm",
      "destination": "/market-entry",
      "permanent": false
    },
    {
      "source": "/service-readiness",
      "destination": "/capital-access",
      "permanent": false
    },
    {
      "source": "/service-introductions",
      "destination": "/capital-access",
      "permanent": false
    },
    {
      "source": "/service-portfolio",
      "destination": "/investors",
      "permanent": false
    },
    {
      "source": "/fundraise",
      "destination": "/capital-review",
      "permanent": false
    },
    {
      "source": "/raise",
      "destination": "/capital-review",
      "permanent": false
    },
    {
      "source": "/raise-capital",
      "destination": "/capital-review",
      "permanent": false
    },
    {
      "source": "/platform",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/growth",
      "destination": "/growth-plan",
      "permanent": false
    },
    {
      "source": "/diagnostic",
      "destination": "/growth-plan",
      "permanent": false
    },
    {
      "source": "/invest",
      "destination": "/investor-network",
      "permanent": false
    },
    {
      "source": "/partners",
      "destination": "/partnerships",
      "permanent": false
    },
    {
      "source": "/events-and-insights",
      "destination": "/insights",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}